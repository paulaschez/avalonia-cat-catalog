<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CatalogoGatos.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <SolidColorBrush x:Key="RosaOscuro">#fa8996</SolidColorBrush>
        <SolidColorBrush x:Key="RosaClaro">#fedbd9</SolidColorBrush>
        <SolidColorBrush x:Key="HoverToggleOn">#c75b65</SolidColorBrush>
    </Application.Resources>
   
</Application>